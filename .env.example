# ========================================================
# ExamHofis AWS & Serverless Configuration
# ========================================================

# Enable AWS Mode (set to 'true' to use AWS Cognito & DynamoDB instead of SQLite)
USE_AWS=false

# AWS Region (e.g. ap-south-1, us-east-1, us-west-2, eu-west-1)
AWS_REGION=ap-south-1

# AWS Credentials (optional if using IAM Role or ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# AWS DynamoDB Multi-Table Names
DYNAMODB_TABLE_USERS=ExamHofis_Users
DYNAMODB_TABLE_STUDENTS=ExamHofis_Students
DYNAMODB_TABLE_TEACHERS=ExamHofis_Teachers

# Optional: Local DynamoDB Endpoint (if using DynamoDB Local on port 8000)
# DYNAMODB_ENDPOINT=http://localhost:8000

# Server Port
PORT=3000
JWT_SECRET=examhofis-super-secret-key-2026
